# ─── FocusArena environment variables ───────────────────────────────
# Copy this file to `.env` and fill in your values.
# .env is gitignored — never commit real secrets to GitHub.

# PostgreSQL connection string.
# Local dev:        postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Production:       paste your Neon pooled connection string here, e.g.
# postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Comma-separated usernames that are auto-promoted to ADMIN on their next
# page load. This is how you crown yourself — put YOUR username here, both
# in your local .env AND in Vercel → Project → Settings → Environment Variables.
# Example (you + a co-admin friend):
ADMIN_USERNAMES="ahmad,layla"
